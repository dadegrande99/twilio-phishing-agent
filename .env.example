# Anthropic
ANTHROPIC_API_KEY=
# claude-haiku-5-5 (economico, default) oppure claude-sonnet-5-5
ANTHROPIC_MODEL=claude-haiku-5-5
# Canale WhatsApp: meta | twilio
CHANNEL=twilio
# Meta WhatsApp Cloud API (solo se CHANNEL=meta, vedi docs/meta-whatsapp.md)
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0
VALIDATE_META_SIGNATURE=true
# Twilio (solo se CHANNEL=twilio, vedi docs/twilio.md)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
VALIDATE_TWILIO_SIGNATURE=true
# Ricezione dei messaggi: polling (default, solo Twilio, niente ngrok) | webhook (obbligatorio con CHANNEL=meta)
INBOUND_MODE=polling
POLL_INTERVAL_SECONDS=5
# URL pubblico di ngrok, senza slash finale (solo con INBOUND_MODE=webhook)
PUBLIC_BASE_URL=
WHITELIST_PATH=config/whitelist.json
ANALYSIS_TIMEOUT_SECONDS=90
DEBUG=false
# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_FILE=logs/app.jsonl
LOG_CONTENT=false
# LangSmith (opzionale, vedi docs/langsmith.md)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=whatsapp-phishing-agent
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# LANGSMITH_HIDE_INPUTS=true
